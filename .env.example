# ==============================================================================
# Blue Lock: Egoist Career Mode - Environment Variables Configuration
# Strict 0€ Budget Architecture (Vercel Hobby + Supabase Free Tier + Groq Free)
# ==============================================================================

# --- SUPABASE CONFIGURATION (Free Tier) ---
# Project URL found in your Supabase Dashboard -> Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon Public Key (safe to expose in client-side Next.js bundle)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Service Role Key (ONLY for secure server-side admin operations/scripts; NEVER expose in client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- AI & NARRATIVE ENGINE CONFIGURATION ---
# Groq Cloud API Key (Free tier, zero credit card required)
# Provides ultra-fast inference with Llama-3.3-70b-versatile for Ego Jinpachi press conferences
# If omitted or if rate limit (HTTP 429) occurs, the game seamlessly activates the built-in offline procedural dialog generator
GROQ_API_KEY=gsk_your_groq_free_api_key_here

# Optional: Google AI Studio API Key (Gemini 2.0 / 1.5 Flash - Free Tier)
# GEMINI_API_KEY=your_gemini_api_key_here

# --- NEXT.JS / VERCEL SETTINGS ---
NODE_ENV=development
